    8,
    6
   ],
   "size": 12,
   "color": "$colors.text_muted",
   "radius": 10,
   "hover": {
    "color": "$colors.text_primary",
    "bg": "$colors.bg_tertiary"
   },
   "active": {
    "color": "$colors.accent",
    "bg": "$colors.accent_dim",
    "weight": 600,
    "shadow": "drawer_tab_glow"
   },
   "labels": [
    "Live Screen",
    "Terminal Logs",
    "Diffs & Code",
    "Agent Runner"
   ]
  },
  "terminal_view": {
   "bg": "#000000",
   "color": "$colors.accent",
   "size": 12,
   "padding": 16,
   "radius": 16,
   "border": "1px solid $colors.terminal_border",
   "shadow": "terminal_inset",
   "text_shadow": "terminal",
   "line_height": 1.6
  },
  "diff_card": {
   "bg": "$colors.bg_tertiary",
   "border": "1px solid $colors.border",
   "radius": 16,
   "shadow": "diff_card",
   "header": {
    "bg": "$colors.bg_elevated",
    "padding": [
     10,
     16
    ],
    "weight": 600,
    "color": "$colors.accent",
    "border_bottom": "$colors.border"
   },
   "body": {
    "padding": [
     10,
     0
    ]
   },
   "line": {
    "padding": [
     2,
     14
    ],
    "add": {
     "bg": "$colors.diff_add_bg",
     "color": "$colors.diff_add_text"
    },
    "del": {
     "bg": "$colors.diff_del_bg",
     "color": "$colors.diff_del_text"
    },
    "ctx": {
     "color": "$colors.text_muted"
    }
   }
  },
  "agent_panel": {
   "title": "AUTONOMOUS AGENT RUNNER",
   "title_size": 13,
   "title_weight": 600,
   "badge_idle": {
    "bg": "$colors.bg_elevated",
    "border": "$colors.border"
   },
   "progress": {
    "track_bg": "$colors.bg_tertiary",
    "track_height": 6,
    "track_radius": 8,
    "track_border": "1px solid $colors.border",
    "fill": "$colors.accent",
    "fill_transition_ms": 300
   },
   "textarea": {
    "min_height": 64,
    "radius": 12,
    "size": 12,
    "padding": [
     10,
     12
    ]
   },
   "max_steps_input": {
    "width": 58,
    "radius": 12,
    "size": 12,
    "padding": [
     6,
     8
    ]
   }
  },
  "scrollbar": {
   "width": 8,
   "height": 8,
   "track": "$colors.bg_primary",
   "thumb": "$colors.border",
   "thumb_radius": 8,
   "thumb_hover": "$colors.accent_dim"
  },
  "palette": {
   "bg": "$colors.bg_secondary",
   "border": "1px solid $colors.accent",
   "radius": 20,
   "width": 660,
   "shadow": "palette",
   "overlay": "$colors.overlay",
   "overlay_blur_px": 16
  }
 }
}