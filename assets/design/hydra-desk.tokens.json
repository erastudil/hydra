    "to": {
     "opacity": 1,
     "translate_y": 0
    }
   },
   "phosphorPulse": {
    "loop": true,
    "easing": "ease-in-out",
    "duration_ms": 2000,
    "0%,100%": {
     "opacity": 1,
     "scale": 1,
     "glow_blur": 10
